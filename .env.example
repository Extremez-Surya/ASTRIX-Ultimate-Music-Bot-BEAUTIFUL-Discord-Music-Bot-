# ====================================
# DISCORD BOT CONFIGURATION
# ====================================
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
CLIENT_ID=YOUR_CLIENT_ID_HERE
PREFIX=.
OWNER_IDS=YOUR_DISCORD_USER_ID

# ====================================
# LAVALINK CONFIGURATION
# ====================================
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# ====================================
# SPOTIFY API (Optional)
# ====================================
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ====================================
# LAST.FM API (Optional)
# ====================================
LASTFM_API_KEY=your_lastfm_api_key

# ====================================
# BOT STATUS CONFIGURATION
# ====================================
STATUS_TEXT=.help | Astrix
STATUS_TYPE=dnd

# ====================================
# WEBHOOK LOGGING (Optional)
# ====================================
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_USERNAME=Astrix Logger
WEBHOOK_AVATAR_URL=
WEBHOOK_INFO_ENABLED=true
WEBHOOK_SUCCESS_ENABLED=true
WEBHOOK_WARNING_ENABLED=true
WEBHOOK_ERROR_ENABLED=true
WEBHOOK_DEBUG_ENABLED=false

# ====================================
# ASSETS
# ====================================
DEFAULT_TRACK_ARTWORK=https://raw.githubusercontent.com/AstrixCode/Astrix/refs/heads/main/thumbnail.png
DEFAULT_THUMBNAIL=https://raw.githubusercontent.com/AstrixCode/Astrix/refs/heads/main/thumbnail.png
HELP_THUMBNAIL=https://raw.githubusercontent.com/AstrixCode/Astrix/refs/heads/main/thumbnail.png

# ====================================
# EXTERNAL LINKS
# ====================================
SUPPORT_SERVER_URL=https://discord.gg/codexdev

# ====================================
# ENVIRONMENT
# ====================================
NODE_ENV=production
DEBUG=false
